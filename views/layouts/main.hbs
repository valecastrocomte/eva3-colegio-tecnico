<!DOCTYPE html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{title}} · Prácticas Profesionales</title>
    <link rel="stylesheet" href="/assets/vendor/bootstrap/css/bootstrap.min.css" />
  </head>
  <body class="d-flex flex-column min-vh-100 bg-body-tertiary">
    <nav class="navbar navbar-expand-lg bg-primary" data-bs-theme="dark">
      <div class="container">
        <a class="navbar-brand" href="/">Prácticas Profesionales</a>
        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#main-nav"
          aria-controls="main-nav"
          aria-expanded="false"
          aria-label="Abrir menú de navegación"
        >
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="main-nav">
          <ul class="navbar-nav me-auto mb-2 mb-lg-0">
            {{#if currentUser}}
              <li class="nav-item">
                <a class="nav-link" href="/practicas">
                  {{#if (eq currentUser.role "profesor")}}Todas las prácticas{{else}}Mis prácticas{{/if}}
                </a>
              </li>
              <li class="nav-item">
                <a class="nav-link" href="/practicas/nueva">Nueva práctica</a>
              </li>
            {{else}}
              <li class="nav-item">
                <a class="nav-link" href="/auth/registro">Registrarse</a>
              </li>
            {{/if}}
          </ul>
          <div class="d-flex align-items-center gap-2">
            {{#if currentUser}}
              <span class="navbar-text text-white small">
                {{#if (eq currentUser.role "profesor")}}Prof. {{/if}}{{currentUser.name}}
              </span>
              <form method="post" action="/auth/logout" class="mb-0">
                <button type="submit" class="btn btn-sm btn-outline-light">Salir</button>
              </form>
            {{else}}
              <a class="btn btn-sm btn-outline-light" href="/auth/login">Iniciar sesión</a>
            {{/if}}
          </div>
        </div>
      </div>
    </nav>

    <main class="container flex-grow-1 py-4">
      {{{body}}}
    </main>

    <footer class="border-top py-3 text-center text-body-secondary">
      <div class="container small">
        Sistema de Gestión de Prácticas Profesionales
      </div>
    </footer>

    <script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  </body>
</html>