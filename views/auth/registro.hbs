<section class="row justify-content-center">
  <div class="col-md-8 col-lg-6">
    {{#if success}}
      <div class="card border-0 shadow-sm">
        <div class="card-body p-4 p-md-5 text-center">
          <h1 class="fs-4 mb-3">¡Cuenta creada!</h1>
          <div class="alert alert-success mb-4">
            Bienvenido(a), <strong>{{fullName}}</strong>. Tu cuenta fue creada correctamente y ya
            puedes iniciar sesión con tu RUT y contraseña.
          </div>
          <a href="/" class="btn btn-primary">Volver al inicio</a>
        </div>
      </div>
    {{else}}
      <div class="card border-0 shadow-sm">
        <div class="card-body p-4 p-md-5">
          <h1 class="fs-4 mb-1">Crear cuenta</h1>
          <p class="text-body-secondary mb-4">
            Regístrate para gestionar tus prácticas profesionales.
          </p>

          <form method="post" action="/auth/registro" novalidate>
            <fieldset class="mb-4">
              <legend class="form-label mb-2">Tipo de cuenta</legend>
              <div class="btn-group w-100" role="group" aria-label="Tipo de cuenta">
                <input
                  type="radio"
                  class="btn-check"
                  name="role"
                  id="role-estudiante"
                  value="estudiante"
                  {{#if (eq form.role "estudiante")}}checked{{/if}}
                />
                <label class="btn btn-outline-primary" for="role-estudiante">Estudiante</label>
                <input
                  type="radio"
                  class="btn-check"
                  name="role"
                  id="role-profesor"
                  value="profesor"
                  {{#if (eq form.role "profesor")}}checked{{/if}}
                />
                <label class="btn btn-outline-primary" for="role-profesor">Profesor</label>
              </div>
            </fieldset>

            <div class="mb-3">
              <label class="form-label" for="rut">RUT</label>
              <input
                type="text"
                class="form-control {{#if errors.rut}}is-invalid{{/if}}"
                id="rut"
                name="rut"
                value="{{form.rut}}"
                placeholder="12.345.678-9"
                autocomplete="username"
              />
              {{#if errors.rut}}<div class="invalid-feedback">{{errors.rut}}</div>{{/if}}
            </div>

            <div class="mb-3">
              <label class="form-label" for="fullName">Nombre completo</label>
              <input
                type="text"
                class="form-control {{#if errors.fullName}}is-invalid{{/if}}"
                id="fullName"
                name="fullName"
                value="{{form.fullName}}"
                placeholder="Nombre y apellidos"
                autocomplete="name"
              />
              {{#if errors.fullName}}<div class="invalid-feedback">{{errors.fullName}}</div>{{/if}}
            </div>

            <div class="mb-3" id="career-field">
              <label class="form-label" for="career">Carrera</label>
              <input
                type="text"
                class="form-control {{#if errors.career}}is-invalid{{/if}}"
                id="career"
                name="career"
                value="{{form.career}}"
                placeholder="Ej.: Técnico en Electrónica"
              />
              {{#if errors.career}}<div class="invalid-feedback">{{errors.career}}</div>{{/if}}
            </div>

            <div class="mb-3 {{#if (eq form.role "estudiante")}}d-none{{/if}}" id="specialty-field">
              <label class="form-label" for="specialty">Especialidad</label>
              <input
                type="text"
                class="form-control {{#if errors.specialty}}is-invalid{{/if}}"
                id="specialty"
                name="specialty"
                value="{{form.specialty}}"
                placeholder="Ej.: Electrónica"
              />
              {{#if errors.specialty}}<div class="invalid-feedback">{{errors.specialty}}</div>{{/if}}
            </div>

            <div class="mb-4">
              <label class="form-label" for="password">Contraseña</label>
              <input
                type="password"
                class="form-control {{#if errors.password}}is-invalid{{/if}}"
                id="password"
                name="password"
                value="{{form.password}}"
                autocomplete="new-password"
              />
              <div class="form-text">Mínimo 8 caracteres.</div>
              {{#if errors.password}}<div class="invalid-feedback">{{errors.password}}</div>{{/if}}
            </div>

            <button type="submit" class="btn btn-primary w-100">Crear cuenta</button>
          </form>
        </div>
      </div>
    {{/if}}
  </div>
</section>

{{#unless success}}
<script>
  const roleInputs = document.querySelectorAll('input[name="role"]')
  const careerField = document.getElementById('career-field')
  const specialtyField = document.getElementById('specialty-field')

  const toggleRoleFields = () => {
    const isStudent = document.querySelector('input[name="role"]:checked')?.value === 'estudiante'
    careerField.classList.toggle('d-none', !isStudent)
    specialtyField.classList.toggle('d-none', isStudent)
  }

  roleInputs.forEach((input) => input.addEventListener('change', toggleRoleFields))
  toggleRoleFields()
</script>
{{/unless}}